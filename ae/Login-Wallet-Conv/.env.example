# ============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=login_opaque_db
DATABASE_URL=postgresql://your_db_username:your_db_password@localhost:5432/login_opaque_db

# ============================================================================
# FYSTACK INTEGRATION
# ============================================================================
FYSTACK_API_URL=http://localhost:8150/api/v1
FYSTACK_WORKSPACE_ID=your_workspace_id
FYSTACK_EMAIL=your_email@example.com
FYSTACK_PASSWORD=your_password

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Generate a secure random string for JWT_SECRET
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Password Hashing
BCRYPT_ROUNDS=12
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Session Management
SESSION_EXPIRES_IN=86400
SESSION_CLEANUP_INTERVAL=3600

# ============================================================================
# SOLANA BLOCKCHAIN CONFIGURATION
# ============================================================================
SOLANA_NETWORK=devnet
# Custom RPC URL (recommended to use a dedicated RPC provider like Alchemy or Helius)
# Example: https://solana-devnet.g.alchemy.com/v2/YOUR_API_KEY
SOLANA_RPC_URL=your_solana_rpc_url_here

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info
ENABLE_CORS=true
