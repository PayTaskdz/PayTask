// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  client
  worker
}

enum AssignmentStatus {
  in_progress
  late
  completed
  expired
}

enum SubmissionStatus {
  submitted
  fix_requested
  rejected
  accepted
}

enum ReviewDecision {
  approve
  reject
  fix
}

enum PayoutStatus {
  queued
  paid
  failed
}

enum NotificationStatus {
  pending
  sent
  read
}

enum ErrorSeverity {
  info
  warning
  error
  critical
}

enum TransactionDirection {
  in
  out
}

enum TransactionStatus {
  pending
  confirmed
  failed
  pending_approval
}

enum TaskStatus {
  draft
  open
  active
  completed
  refund
  cancelled
}

// ============================================
// MODELS
// ============================================

model User {
  id                   String   @id @default(uuid()) @db.Uuid
  email                String   @unique @db.VarChar(255)
  username             String   @unique @db.VarChar(255)
  passwordHash         String   @map("password_hash") @db.VarChar(255)
  role                 UserRole @default(client)
  isActive             Boolean  @default(true) @map("is_active")
  fystackSessionCookie String?  @map("fystack_session_cookie") @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations  
  tasksCreated      Task[]         @relation("TaskClient")
  workerProfile     WorkerProfile?
  wallet            Wallet[]
  auditLogs         AuditLog[]
  assignments       Assignment[]
  payouts           Payout[]
  ratingsGiven      Rating[]       @relation("RatingFrom")
  ratingsReceived   Rating[]       @relation("RatingTo")
  notifications     Notification[]
  commsLogs         CommsLog[]
  reviews           Review[]
  errorLogs         ErrorLog[]     @relation("ErrorLogUser")
  resolvedErrorLogs ErrorLog[]     @relation("ErrorLogResolver")
  sessions          Session[]

  @@map("users")   
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  isActive  Boolean  @default(true) @map("is_active")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model WorkerProfile {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  skills           Json?
  languages        Json?
  availability     Json?
  reputation       Float    @default(0) @db.Real
  completedTasks   Int      @default(0) @map("completed_tasks")
  earlySubmissions Int      @default(0) @map("early_submissions")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_profiles")
}

model Wallet {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  fystackWalletId    String   @map("fystack_wallet_id") @db.VarChar(255)
  fystackWorkspaceId String   @map("fystack_workspace_id") @db.VarChar(255)
  addresses          Json     @map("addresses")
  walletName         String   @map("wallet_name") @db.VarChar(255)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id          String                @id @default(uuid()) @db.Uuid
  hash        String?               @unique @db.VarChar(255)
  fromAddress String                @map("fromAddress") @db.VarChar(255)
  toAddress   String                @map("toAddress") @db.VarChar(255)
  amount      String
  network     String
  assetSymbol String                @map("assetSymbol")
  assetName   String                @map("assetName")
  fee         Decimal?              @db.Decimal(20, 10)
  direction   TransactionDirection?
  type        String
  status      TransactionStatus     @default(pending)
  blockTime   DateTime              @map("blockTime")
  walletId    String                @map("walletId") @db.Uuid
  createdAt   DateTime              @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updatedAt") @db.Timestamptz(6)

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, blockTime], name: "IDX_transactions_walletId_blockTime")
  @@map("transactions")
}

model AuditLog {
  id      String   @id @default(uuid()) @db.Uuid
  actorId String?  @map("actor_id") @db.Uuid
  action  String   @db.VarChar(255)
  details Json?
  ts      DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  clientId    String     @map("client_id") @db.Uuid
  title       String     @db.VarChar(255)
  description String?    @db.Text
  category    String?    @db.VarChar(100)
  reward      Decimal    @db.Decimal(10, 2)
  qty         Int        @default(1)
  budget      Decimal?   @db.Decimal(12, 2)
  feePercent  Decimal    @default(5.00) @map("fee_percent") @db.Decimal(5, 2)
  deadline    DateTime?  @db.Timestamptz(6)
  status      TaskStatus @default(draft)
  txHash      String?    @map("tx_hash") @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  client      User         @relation("TaskClient", fields: [clientId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  ratings     Rating[]

  @@index([clientId])
  @@index([status])
  @@index([category])
  @@map("tasks")
}

model Assignment {
  id        String           @id @default(uuid()) @db.Uuid
  taskId    String           @map("task_id") @db.Uuid
  workerId  String           @map("worker_id") @db.Uuid
  status    AssignmentStatus @default(in_progress)
  startedAt DateTime?        @map("started_at") @db.Timestamptz(6)
  dueAt     DateTime?        @map("due_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  worker     User        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  submission Submission?

  @@map("assignments")
}

model Submission {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @unique @map("assignment_id") @db.Uuid
  payloadUrl   String?          @map("payload_url") @db.VarChar(500)
  payloadHash  String           @map("payload_hash") @db.VarChar(255)
  qaFlags      Json?            @map("qa_flags")
  status       SubmissionStatus @default(submitted)
  submittedAt  DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviews    Review[]
  payouts    Payout[]

  @@map("submissions")
}

model Review {
  id           String         @id @default(uuid()) @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  reviewerId   String         @map("reviewer_id") @db.Uuid
  decision     ReviewDecision
  feedback     String?        @db.Text
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User       @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Payout {
  id            String       @id @default(uuid()) @db.Uuid
  submissionId  String       @map("submission_id") @db.Uuid
  workerId      String       @map("worker_id") @db.Uuid
  amountNet     Decimal      @map("amount_net") @db.Decimal(10, 2)
  status        PayoutStatus @default(queued)
  txHashRelease String?      @map("tx_hash_release") @db.VarChar(255)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  worker     User       @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("payouts")
}

model Rating {
  id         String   @id @default(uuid()) @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  score      Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  fromUser User @relation("RatingFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("RatingTo", fields: [toUserId], references: [id], onDelete: Cascade)
  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  toUserId  String             @map("to_user_id") @db.Uuid
  type      String             @db.VarChar(100)
  content   String?            @db.Text
  status    NotificationStatus @default(pending)
  meta      Json?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  toUser User @relation(fields: [toUserId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model CommsLog {
  id      String   @id @default(uuid()) @db.Uuid
  whoId   String   @map("who_id") @db.Uuid
  channel String?  @db.VarChar(100)
  what    String?  @db.Text
  when    DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  who User @relation(fields: [whoId], references: [id], onDelete: Cascade)

  @@map("comms_logs")
}

model SystemPolicy {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_policies")
}

model ErrorLog {
  id            String        @id @default(uuid()) @db.Uuid
  errorCode     String        @map("error_code") @db.VarChar(255)
  errorMessage  String        @map("error_message") @db.Text
  errorStack    String?       @map("error_stack") @db.Text
  endpoint      String?       @db.VarChar(255)
  method        String?       @db.VarChar(10)
  userId        String?       @map("user_id") @db.Uuid
  requestBody   Json?         @map("request_body")
  requestParams Json?         @map("request_params")
  requestQuery  Json?         @map("request_query")
  userAgent     String?       @map("user_agent") @db.Text
  ipAddress     String?       @map("ip_address") @db.VarChar(45)
  severity      ErrorSeverity @default(error)
  resolved      Boolean       @default(false)
  resolvedAt    DateTime?     @map("resolved_at") @db.Timestamptz(6)
  resolvedBy    String?       @map("resolved_by") @db.Uuid
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user     User? @relation("ErrorLogUser", fields: [userId], references: [id], onDelete: SetNull)
  resolver User? @relation("ErrorLogResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([errorCode])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@index([userId])
  @@map("error_logs")
}
